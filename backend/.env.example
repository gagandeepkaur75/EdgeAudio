# Copy to .env and fill in real values. Never commit .env.

PORT=3000

# Admin login
ADMIN_USERNAME=admin
# Generate with: node -e "console.log(require('bcryptjs').hashSync('yourpassword', 10))"
ADMIN_PASSWORD_HASH=
# Long random string, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# JSON database file
DB_PATH=./data/app.db

# Comma-separated frontend origins allowed to call the API (wildcard subdomains: https://*.example.com).
# Leave empty only for local development (allows any origin).
ALLOWED_ORIGINS=http://localhost:5173

# Object storage (S3 or Cloudflare R2). Leave S3_ACCESS_KEY_ID / S3_BUCKET empty to store uploads on local disk.
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_PUBLIC_BASE_URL=

# Public base URL of this server, used for file links when uploads are stored locally
LOCAL_UPLOAD_URL=http://localhost:3000
