<mxfile host="app.diagrams.net"><diagram name="Class Diagram - Frontend Audio Analysis and Call Module" id="07_class_frontend"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n_an" value='&lt;p style="margin:4px;text-align:center"&gt;&lt;b&gt;MLAudioAnalyzer&lt;/b&gt;&lt;/p&gt;&lt;hr size="1"/&gt;&lt;p style="margin:0 6px"&gt;- session: InferenceSession&lt;br/&gt;- melBasis: Float32Array[]&lt;br/&gt;- normStats: {mean, std}&lt;br/&gt;- audioBuffer: Float32Array(32000)&lt;br/&gt;- speechBuffer: Float32Array(48000)&lt;br/&gt;- smoothedMos: number&lt;br/&gt;- lastResult: AnalysisResult&lt;/p&gt;&lt;hr size="1"/&gt;&lt;p style="margin:0 6px"&gt;+ init(modelPath): Promise&lt;br/&gt;+ pushAudio(pcm, rate, active)&lt;br/&gt;- _resample(input, rate)&lt;br/&gt;+ getOrderedWindow()&lt;br/&gt;+ extractFeatures(audio)&lt;br/&gt;+ predict(): Promise&amp;lt;Result&amp;gt;&lt;br/&gt;+ resetAll() / resetBuffer()&lt;/p&gt;' style="verticalAlign=top;align=left;overflow=fill;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#000000;strokeColor=#000000;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="330" y="20" width="290" height="290" as="geometry"/></mxCell><mxCell id="n_res" value='&lt;p style="margin:4px;text-align:center"&gt;&lt;b&gt;AnalysisResult&lt;/b&gt;&lt;/p&gt;&lt;hr size="1"/&gt;&lt;p style="margin:0 6px"&gt;mos, rawMos: number&lt;br/&gt;voiceProb, snr: number&lt;br/&gt;noise/clip/muffle/&lt;br/&gt;  dropout/windProb&lt;br/&gt;latencyMs: number&lt;br/&gt;engine: string&lt;br/&gt;isSilent: boolean&lt;/p&gt;&lt;hr size="1"/&gt;&lt;p style="margin:0 6px"&gt;&lt;/p&gt;' style="verticalAlign=top;align=left;overflow=fill;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#000000;strokeColor=#000000;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="700" y="40" width="200" height="190" as="geometry"/></mxCell><mxCell id="n_ort" value='&lt;p style="margin:4px;text-align:center"&gt;&lt;b&gt;ort.InferenceSession&lt;/b&gt;&lt;/p&gt;&lt;hr size="1"/&gt;&lt;p style="margin:0 6px"&gt;(onnxruntime-web 1.30)&lt;/p&gt;&lt;hr size="1"/&gt;&lt;p style="margin:0 6px"&gt;+ create(path, opts)&lt;br/&gt;+ run(feeds): outputs&lt;/p&gt;' style="verticalAlign=top;align=left;overflow=fill;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#000000;strokeColor=#000000;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="700" y="270" width="200" height="100" as="geometry"/></mxCell><mxCell id="n_fft" value='&lt;p style="margin:4px;text-align:center"&gt;&lt;b&gt;FFT utilities&lt;/b&gt;&lt;/p&gt;&lt;hr size="1"/&gt;&lt;p style="margin:0 6px"&gt;FFT_SIZE = 512&lt;br/&gt;HANN_WINDOW&lt;br/&gt;BIT_REVERSE_TABLE&lt;/p&gt;&lt;hr size="1"/&gt;&lt;p style="margin:0 6px"&gt;initFftTables()&lt;br/&gt;computeRealFftMagnitude()&lt;/p&gt;' style="verticalAlign=top;align=left;overflow=fill;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#000000;strokeColor=#000000;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="230" height="140" as="geometry"/></mxCell><mxCell id="n_lc" value='&lt;p style="margin:4px;text-align:center"&gt;&lt;b&gt;LiveCommunication (page)&lt;/b&gt;&lt;/p&gt;&lt;hr size="1"/&gt;&lt;p style="margin:0 6px"&gt;- source: mic | demo | pc&lt;br/&gt;- simulator: SimSettings&lt;br/&gt;- meetingId, userId, role&lt;br/&gt;- peer: RTCPeerConnection&lt;/p&gt;&lt;hr size="1"/&gt;&lt;p style="margin:0 6px"&gt;+ startAnalysis()&lt;br/&gt;+ stopAnalysis()&lt;br/&gt;+ startCall() / joinCall()&lt;br/&gt;+ pollSignals()&lt;br/&gt;+ leaveCall()&lt;/p&gt;' style="verticalAlign=top;align=left;overflow=fill;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#000000;strokeColor=#000000;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="20" y="330" width="270"