<mxfile host="app.diagrams.net"><diagram name="Class Diagram - Backend API, Signalling and Deliverables" id="08_class_backend"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n_app" value='&lt;p style="margin:4px;text-align:center"&gt;&lt;b&gt;ExpressApp (index.js)&lt;/b&gt;&lt;/p&gt;&lt;hr size="1"/&gt;&lt;p style="margin:0 6px"&gt;- PORT, ALLOWED_ORIGINS&lt;br/&gt;- json limit: 100 kB&lt;/p&gt;&lt;hr size="1"/&gt;&lt;p style="margin:0 6px"&gt;+ GET /api/health&lt;br/&gt;+ use(cors, routes)&lt;br/&gt;+ errorHandler()&lt;/p&gt;' style="verticalAlign=top;align=left;overflow=fill;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#000000;strokeColor=#000000;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="330" y="10" width="250" height="120" as="geometry"/></mxCell><mxCell id="n_auth" value='&lt;p style="margin:4px;text-align:center"&gt;&lt;b&gt;AuthModule (auth.js)&lt;/b&gt;&lt;/p&gt;&lt;hr size="1"/&gt;&lt;p style="margin:0 6px"&gt;- failures: Map&amp;lt;ip, entry&amp;gt;&lt;br/&gt;- MAX_FAILURES = 5&lt;br/&gt;- WINDOW_MS = 15 min&lt;/p&gt;&lt;hr size="1"/&gt;&lt;p style="margin:0 6px"&gt;+ login(req, res)&lt;br/&gt;+ requireAuth(req, res, next)&lt;br/&gt;- isLockedOut(ip)&lt;br/&gt;- recordFailure(ip)&lt;/p&gt;' style="verticalAlign=top;align=left;overflow=fill;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#000000;strokeColor=#000000;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="10" y="10" width="260" height="170" as="geometry"/></mxCell><mxCell id="n_mr" value='&lt;p style="margin:4px;text-align:center"&gt;&lt;b&gt;MeetingRouter&lt;/b&gt;&lt;/p&gt;&lt;hr size="1"/&gt;&lt;p style="margin:0 6px"&gt;- rooms: Map&amp;lt;id, Room&amp;gt;&lt;br/&gt;- MAX_ROOMS = 500&lt;br/&gt;- MAX_USERS_PER_ROOM = 8&lt;br/&gt;- USER_TIMEOUT_MS = 45 s&lt;/p&gt;&lt;hr size="1"/&gt;&lt;p style="margin:0 6px"&gt;+ GET /:id/check&lt;br/&gt;+ POST /join&lt;br/&gt;+ GET /:id/poll&lt;br/&gt;+ POST /signal&lt;br/&gt;+ POST /leave&lt;/p&gt;' style="verticalAlign=top;align=left;overflow=fill;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#000000;strokeColor=#000000;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="10" y="240" width="250" height="210" as="geometry"/></mxCell><mxCell id="n_room" value='&lt;p style="margin:4px;text-align:center"&gt;&lt;b&gt;Room&lt;/b&gt;&lt;/p&gt;&lt;hr size="1"/&gt;&lt;p style="margin:0 6px"&gt;createdAt: number&lt;/p&gt;&lt;hr size="1"/&gt;&lt;p style="margin:0 6px"&gt;participantCount()&lt;/p&gt;' style="verticalAlign=top;align=left;overflow=fill;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#000000;strokeColor=#000000;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="10" y="520" width="170" height="80" as="geometry"/></mxCell><mxCell id="n_part" value='&lt;p style="margin:4px;text-align:center"&gt;&lt;b&gt;Participant&lt;/b&gt;&lt;/p&gt;&lt;hr size="1"/&gt;&lt;p style="margin:0 6px"&gt;userId: string&lt;br/&gt;role: host | peer&lt;br/&gt;joinedAt, lastSeen&lt;/p&gt;&lt;hr size="1"/&gt;&lt;p style="margin:0 6px"&gt;&lt;/p&gt;' style="verticalAlign=top;align=left;overflow=fill;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#000000;strokeColor=#000000;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="230" y="520" width="170" height="90" as="geometry"/></mxCell><mxCell id="n_sig" value='&lt;p style="margin:4px;text-align:center"&gt;&lt;b&gt;Signal&lt;/b&gt;&lt;/p&gt;&lt;hr size="1"/&gt;&lt;p style="margin:0 6px"&gt;senderId: string&lt;br/&gt;signalData: SDP | ICE&lt;br/&gt;timestamp: number&lt;/p&gt;&lt;hr size="1"/&gt;&lt;p style="margin:0 6px"&gt;&lt;/p&gt;' style="verticalAlign=top;align=left;overflow=fill;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#000000;strokeColor=#000000;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="120" y="670" width="180" height="90" as="geometry"/></mxCell><mxCell id="n_ur" value='&lt;p style="margin:4px;text-align:center"&gt;&lt;b&gt;UploadRouter&lt;/b&gt;&lt;/p&gt;&lt;hr size="1"/&gt;&lt;p style="margin:0 6px"&gt;&lt;/p&gt;&lt;hr size="1"/&gt;&lt;p style="margin:0 6px"&gt;+ POST / (requireAuth,&lt;br/&gt;  multer.single)&lt;/p&gt;' style="verticalAlign=top;align=left;overflow=fill;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#000000;strokeColor=#000000;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="330" y="240" width="200" height="80" as="geometry"/></mxCell><mxCell id="n_pr" value='&lt;p style="margin:4px;text-align:center"&gt;&lt;b&gt;PublishRouter&lt;/b&gt;&lt;/p&gt;&lt;hr size="1"/&gt;&lt;p style="margin:0 6px"&gt;- SLUG_PATTERN&lt;br/&gt;- RESERVED_SLUGS&lt;/p&gt;&lt;hr size="1"/&gt;&lt;p style="margin:0 6px"&gt;+ POST / (requireAuth)&lt;/p&gt;' style="verticalAlign=top;align=left;overflow=fill;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#000000;strokeColor=#000000;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="330" y="360" width="200" height="100" as="geometry"/></mxCell><mxCell id="n_dr" value='&lt;p style="margin:4px;text-align:center"&gt;&lt;b&gt;DeliverablesRouter&lt;/b&gt;&lt;/p&gt;&lt;hr size="1"/&gt;&lt;p style="margin:0 6px"&gt;&lt;/p&gt;&lt;hr size="1"/&gt;&lt;p style="margin:0 6px"&gt;+ GET /&lt;br/&gt;+ GET /:slug&lt;/p&gt;' style="verticalAlign=top;align=left;overflow=fill;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#000000;strokeColor=#000000;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="330" y="500" width="200" height="80" as="geometry"/></mxCell><mxCell id="n_st" value='&lt;p style="margin:4px;text-align:center"&gt;&lt;b&gt;StorageService (storage.js)&lt;/b&gt;&lt;/p&gt;&lt;hr size="1"/&gt;&lt;p style="margin:0 6px"&gt;- s3: S3Client | null&lt;/p&gt;&lt;hr size="1"/&gt;&lt;p style="margin:0 6px"&gt;+ putObject(key, buf, type)&lt;br/&gt;+ publicUrl(key)&lt;br/&gt;  (falls back to local disk)&lt;/p&gt;' style="verticalAlign=top;align=left;overflow=fill;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#000000;strokeColor=#000000;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="610" y="220" width="250" height="110" as="geometry"/></mxCell><mxCell id="n_db" value='&lt;p style="margin:4px;text-align:center"&gt;&lt;b&gt;Database (shim)&lt;/b&gt;&lt;/p&gt;&lt;hr size="1"/&gt;&lt;p style="margin:0 6px"&gt;- dbPath: string&lt;/p&gt;&lt;hr size="1"/&gt;&lt;p style="margin:0 6px"&gt;+ prepare(sql): Statement&lt;br/&gt;+ exec(sql), pragma()&lt;/p&gt;' style="verticalAlign=top;align=left;overflow=fill;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#000000;strokeColor=#000000;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="610" y="380" width="250" height="90" as="geometry"/></mxCell><mxCell id="n_dl" value='&lt;p style="margin:4px;text-align:center"&gt;&lt;b&gt;Deliverable&lt;/b&gt;&lt;/p&gt;&lt;hr size="1"/&gt;&lt;p style="margin:0 6px"&gt;id: int (PK)&lt;br/&gt;slug: string (unique)&lt;br/&gt;title, deliverable_type&lt;br/&gt;version, presentation_date&lt;br/&gt;authors, change_summary&lt;br/&gt;file_key, file_url&lt;br/&gt;original_filename&lt;br/&gt;file_size_bytes&lt;br/&gt;published_at&lt;/p&gt;&lt;hr size="1"/&gt;&lt;p style="margin:0 6px"&gt;&lt;/p&gt;' style="verticalAlign=top;align=left;overflow=fill;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#000000;strokeColor=#000000;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="610" y="520" width="250" height="200" as="geometry"/></mxCell><mxCell id="e0" value="mounts" style="html=1;edgeStyle=none;rounded=0;fontSize=11;fontColor=#000000;strokeColor=#000000;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;dashed=1;" edge="1" parent="1" source="n_app" target="n_auth"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e1" value="/api/meeting" style="html=1;edgeStyle=none;rounded=0;fontSize=11;fontColor=#000000;strokeColor=#000000;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;dashed=1;" edge="1" parent="1" source="n_app" target="n_mr"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="300" y="160"/></Array></mxGeometry></mxCell><mxCell id="e2" value="/api/upload" style="html=1;edgeStyle=none;rounded=0;fontSize=11;fontColor=#000000;strokeColor=#000000;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;dashed=1;" edge="1" parent="1" source="n_app" target="n_ur"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="/api/publish" style="html=1;edgeStyle=none;rounded=0;fontSize=11;fontColor=#000000;strokeColor=#000000;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;dashed=1;" edge="1" parent="1" source="n_app" target="n_pr"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="600" y="200"/><mxPoint x="600" y="340"/></Array></mxGeometry></mxCell><mxCell id="e4" value="0..500" style="html=1;edgeStyle=none;rounded=0;fontSize=11;fontColor=#000000;strokeColor=#000000;labelBackgroundColor=#ffffff;startArrow=diamondThin;startFill=1;endArrow=none;startSize=14;" edge="1" parent="1" source="n_mr" target="n_room"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="0..8" style="html=1;edgeStyle=none;rounded=0;fontSize=11;fontColor=#000000;strokeColor=#000000;labelBackgroundColor=#ffffff;startArrow=diamondThin;startFill=1;endArrow=none;startSize=14;" edge="1" parent="1" source="n_room" target="n_part"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="queued *" style="html=1;edgeStyle=none;rounded=0;fontSize=11;fontColor=#000000;strokeColor=#000000;labelBackgroundColor=#ffffff;startArrow=diamondThin;startFill=1;endArrow=none;startSize=14;" edge="1" parent="1" source="n_room" target="n_sig"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="requireAuth" style="html=1;edgeStyle=none;rounded=0;fontSize=11;fontColor=#000000;strokeColor=#000000;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;dashed=1;" edge="1" parent="1" source="n_ur" target="n_auth"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="290" y="280"/><mxPoint x="290" y="200"/></Array></mxGeometry></mxCell><mxCell id="e8" value="uses" style="html=1;edgeStyle=none;rounded=0;fontSize=11;fontColor=#000000;strokeColor=#000000;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;dashed=1;" edge="1" parent="1" source="n_ur" target="n_st"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e9" value="writes" style="html=1;edgeStyle=none;rounded=0;fontSize=11;fontColor=#000000;strokeColor=#000000;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;dashed=1;" edge="1" parent="1" source="n_pr" target="n_db"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e10" value="reads" style="html=1;edgeStyle=none;rounded=0;fontSize=11;fontColor=#000000;strokeColor=#000000;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;dashed=1;" edge="1" parent="1" source="n_dr" target="n_db"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e11" value="stores *" style="html=1;edgeStyle=none;rounded=0;fontSize=11;fontColor=#000000;strokeColor=#000000;labelBackgroundColor=#ffffff;startArrow=diamondThin;startFill=1;endArrow=none;startSize=14;" edge="1" parent="1" source="n_db" target="n_dl"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>