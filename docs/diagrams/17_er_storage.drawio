<mxfile host="app.diagrams.net"><diagram name="Storage Design - Deliverables Schema and In-Memory Signalling Model" id="17_er_storage"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n_dl" value='&lt;p style="margin:4px;text-align:center"&gt;&lt;b&gt;deliverables  (persistent, JSON DB file)&lt;/b&gt;&lt;/p&gt;&lt;hr size="1"/&gt;&lt;p style="margin:0 6px"&gt;PK  id : INTEGER (auto-increment)&lt;br/&gt;UQ  slug : TEXT NOT NULL&lt;br/&gt;      title : TEXT NOT NULL&lt;br/&gt;      deliverable_type : TEXT NOT NULL&lt;br/&gt;      version : TEXT NOT NULL&lt;br/&gt;      presentation_date : TEXT (YYYY-MM-DD)&lt;br/&gt;      authors : TEXT NOT NULL&lt;br/&gt;      change_summary : TEXT&lt;br/&gt;      file_key : TEXT NOT NULL&lt;br/&gt;      file_url : TEXT NOT NULL&lt;br/&gt;      original_filename : TEXT&lt;br/&gt;      file_size_bytes : INTEGER&lt;br/&gt;      published_at : TEXT DEFAULT now&lt;/p&gt;&lt;hr size="1"/&gt;&lt;p style="margin:0 6px"&gt;&lt;/p&gt;' style="verticalAlign=top;align=left;overflow=fill;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#000000;strokeColor=#000000;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="330" height="290" as="geometry"/></mxCell><mxCell id="n_obj" value='&lt;p style="margin:4px;text-align:center"&gt;&lt;b&gt;stored_object  (S3 / R2 / disk)&lt;/b&gt;&lt;/p&gt;&lt;hr size="1"/&gt;&lt;p style="margin:0 6px"&gt;PK  key : &amp;lt;timestamp&amp;gt;-&amp;lt;rand&amp;gt;-&amp;lt;name&amp;gt;&lt;br/&gt;      bytes, content_type&lt;br/&gt;      public URL&lt;/p&gt;&lt;hr size="1"/&gt;&lt;p style="margin:0 6px"&gt;&lt;/p&gt;' style="verticalAlign=top;align=left;overflow=fill;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#000000;strokeColor=#000000;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="20" y="380" width="330" height="100" as="geometry"/></mxCell><mxCell id="n_room" value='&lt;p style="margin:4px;text-align:center"&gt;&lt;b&gt;Room  (in memory only)&lt;/b&gt;&lt;/p&gt;&lt;hr size="1"/&gt;&lt;p style="margin:0 6px"&gt;PK  meetingId : [A-Z0-9_-]{1,64}&lt;br/&gt;      createdAt : number&lt;/p&gt;&lt;hr size="1"/&gt;&lt;p style="margin:0 6px"&gt;&lt;/p&gt;' style="verticalAlign=top;align=left;overflow=fill;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#000000;strokeColor=#000000;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="470" y="20" width="300" height="80" as="geometry"/></mxCell><mxCell id="n_par" value='&lt;p style="margin:4px;text-align:center"&gt;&lt;b&gt;Participant  (in memory)&lt;/b&gt;&lt;/p&gt;&lt;hr size="1"/&gt;&lt;p style="margin:0 6px"&gt;PK  userId&lt;br/&gt;FK  meetingId&lt;br/&gt;      role : host | peer&lt;br/&gt;      joinedAt, lastSeen&lt;/p&gt;&lt;hr size="1"/&gt;&lt;p style="margin:0 6px"&gt;&lt;/p&gt;' style="verticalAlign=top;align=left;overflow=fill;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#000000;strokeColor=#000000;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="470" y="170" width="300" height="110" as="geometry"/></mxCell><mxCell id="n_sq" value='&lt;p style="margin:4px;text-align:center"&gt;&lt;b&gt;SignalQueueItem  (in memory)&lt;/b&gt;&lt;/p&gt;&lt;hr size="1"/&gt;&lt;p style="margin:0 6px"&gt;FK  meetingId, targetUserId&lt;br/&gt;      senderId&lt;br/&gt;      signalData (&amp;lt;= 16 kB)&lt;br/&gt;      timestamp&lt;/p&gt;&lt;hr size="1"/&gt;&lt;p style="margin:0 6px"&gt;&lt;/p&gt;' style="verticalAlign=top;align=left;overflow=fill;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#000000;strokeColor=#000000;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="470" y="350" width="300" height="110" as="geometry"/></mxCell><mxCell id="e0" value="file_key -&amp;gt; key  (1 : 1)" style="html=1;edgeStyle=none